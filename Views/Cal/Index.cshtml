@model CalIndexVm;
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <form asp-action="Run" asp-controller="Cal">
        <label asp-for="Number1"></label>
        <input asp-for="Number1" value="@Model.Number1" />
        <br />
        <label asp-for="Number2" hidden="true"></label>
        <input asp-for="Number2" value="@Model.Number2" hidden="true"/>
        <br />
        <strong>@Model.Result</strong>
        <br />
        <input type="submit" asp-for="Operation" value="+" />
        <input type="submit" asp-for="Operation" value="-" />
        <input type="submit" asp-for="Operation" value="*" />
        <input type="submit" asp-for="Operation" value="/" />
    </form>
    <button>1</button>
    <button>2</button>
    <button>3</button>
    <br />
    <button>4</button>
    <button>5</button>
    <button>6</button>
    <br />
    <button>7</button>
    <button>8</button>
    <button>9</button>
    <br />
    <button>0</button>
    <button>C</button>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script>
            $(document).ready(function(){
            $('button').click(function(){
            var valueTxt=$(this).text();
                
            if($('#Number1').val()==='0'  || valueTxt=='C')
                $('#Number1').val('')
            $('#Number1').val($('#Number1').val()+valueTxt);
            });
            });
    </script>
</body>
</html>