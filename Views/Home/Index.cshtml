@model WebKalkulator.Models.KalModels
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "Home Page";
}
<html>
<body>
    <a asp-controller="Home" asp-action="Index">Go to HomeControler</a>
    <br />
    <a asp-controller="Test" asp-action="Index" asp-fragment="Go to TestControler" asp-route-id="20">Go to TestControler</a>
    <br />
    <a asp-controller="Person" asp-action="Index">Go to PersonControler</a>
    <br />

    <br />
    <div class="text-center">
        <form asp-action="Index" asp-controller="Home">
            <input asp-for="Number1" value="@Model.Number1" />
            <br />
            <input asp-for="Number2" value="@Model.Number2" />
            <br />
            @Model.Result;
            <input type="submit" asp-for="Opertation" value="+" />
            <input type="submit" asp-for="Opertation" value="-" />
            <input type="submit" asp-for="Opertation" value="*" />
            <input type="submit" asp-for="Opertation" value="/" />
        </form>
        <button>1</button>
        <button>2</button>
        <button>3</button>
        <br />

        <button>4</button>
        <button>5</button>
        <button>6</button>
        <br />
        <button>7</button>
        <button>8</button>
        <button>9</button>
        <br />
        <button>0</button>
        <input type="submit" asp-for="Opertation" value="+" />
    </div>
</body>
</html>

